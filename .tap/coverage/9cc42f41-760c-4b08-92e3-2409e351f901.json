c,CAAC,CAAC;IACnD,MAAM,SAAS,GAAG,cAAc,GAAG,CAAC,CAAC;IAErC,6EAA6E;IAC7E,KAAK,IAAI,CAAC,GAAG,CAAC,EAAE,CAAC,GAAG,cAAc,EAAE,CAAC,EAAE,EAAE,CAAC;QACxC,sEAAsE;QACtE,IAAI,SAAS,KAAK,CAAC,EAAE,CAAC;YACpB,MAAM,CAAC,CAAC,CAAC,GAAG,UAAU,CAAC,CAAC,CAAE,CAAC;YAC3B,SAAS;QACX,CAAC;QAED,2CAA2C;QAC3C,MAAM,CAAC,GAAG,CAAC,GAAG,SAAS,CAAC;QAExB,oEAAoE;QACpE,kDAAkD;QAClD,MAAM,YAAY,GAAG,QAAQ,CAAC,MAAM,GAAG,CAAC,CAAC;QACzC,MAAM,YAAY,GAAG,IAAI,CAAC,KAAK,CAAC,CAAC,GAAG,YAAY,CAAC,CAAC;QAElD,iDAAiD;QACjD,MAAM,cAAc,GAAG,IAAI,CAAC,GAAG,CAAC,YAAY,EAAE,YAAY,GAAG,CAAC,CAAC,CAAC;QAChE,MAAM,YAAY,GAAG,cAAc,GAAG,CAAC,CAAC;QAExC,gFAAgF;QAChF,yCAAyC;QACzC,MAAM,WAAW,GAAG,CAAC,GAAG,YAAY,CAAC;QACrC,MAAM,MAAM,GAAG,CAAC,CAAC,GAAG,CAAC,cAAc,GAAG,WAAW,CAAC,CAAC,GAAG,WAAW,CAAC;QAElE,MAAM,QAAQ,GAAG,QAAQ,CAAC,cAAc,CAAE,CAAC;QAC3C,MAAM,MAAM,GAAG,QAAQ,CAAC,YAAY,CAAE,CAAC;QAEvC,8BAA8B;QAC9B,MAAM,CAAC,GAAG,QAAQ,CAAC,CAAC,CAAC,GAAG,CAAC,MAAM,CAAC,CAAC,CAAC,GAAG,QAAQ,CAAC,CAAC,CAAC,CAAC,GAAG,MAAM,CAAC;QAC3D,MAAM,CAAC,GAAG,QAAQ,CAAC,CAAC,CAAC,GAAG,CAAC,MAAM,CAAC,CAAC,CAAC,GAAG,QAAQ,CAAC,CAAC,CAAC,CAAC,GAAG,MAAM,CAAC;QAC3D,MAAM,CAAC,GAAG,QAAQ,CAAC,CAAC,CAAC,GAAG,CAAC,MAAM,CAAC,CAAC,CAAC,GAAG,QAAQ,CAAC,CAAC,CAAC,CAAC,GAAG,MAAM,CAAC;QAE3D,MAAM,CAAC,CAAC,CAAC,GAAG,IAAI,KAAK,CAAC,CAAC,CAAC,GAAG,KAAK,CAAC,CAAC,CAAC,GAAG,KAAK,CAAC,CAAC,CAAC,EAAE,CAAC;IACnD,CAAC;IAED,OAAO,MAAM,CAAC;AAChB,CAAC",
        "sourcesContent": [
          "// Helper: integer to 2-char hex\nfunction toHex(c: number): string {\n  const hex = Math.round(c).toString(16);\n  return hex.length === 1 ? '0' + hex : hex;\n}\n\n// Helper: Parse #123456 to [r, g, b]\nfunction parseColorToRgb(hex: string): [number, number, number] {\n  const cleanHex = hex.replace('#', '');\n  const bigint = parseInt(cleanHex, 16);\n  return [\n    (bigint >> 16) & 255, // R\n    (bigint >> 8) & 255,  // G\n    bigint & 255          // B\n  ];\n}\n\n// Helper: Inverts RGB for a true complementary color\nfunction generateComplementary(hex: string): string {\n  const [r, g, b] = parseColorToRgb(hex);\n  return `#${toHex(255 - r)}${toHex(255 - g)}${toHex(255 - b)}`;\n}\n\n// Helper: Validates 6-character hex codes\nfunction isColorValid(color: string): boolean {\n  return /^#[0-9A-Fa-f]{6}$/.test(color);\n}\n\nfunction generateRandomColor(): string {\n  // Uses bitwise operator for slightly faster integer floor\n  return `#${Math.floor(Math.random() * 0xFFFFFF).toString(16).padStart(6, '0')}`;\n}\n\n/**\n * Generates an array of gradient colors.\n * Optimized to strictly adhere to array length and minimize string parsing.\n */\nfunction generateGradient(colors: string[] = [], numberOfColors: number = 10): string[] {\n  if (!Number.isInteger(numberOfColors) || numberOfColors < 0) {\n    throw new RangeError('Number of colors should be a non-negative integer');\n  }\n\n  // 1. Handle Edge Case: 0 requested colors\n  if (numberOfColors === 0) return [];\n\n  // 2. Handle Default Colors\n  // Create a copy to avoid mutating the passed reference\n  const stopColors = [...colors]; \n\n  if (stopColors.length === 0) {\n    stopColors.push(generateRandomColor());\n  }\n\n  // If only 1 color, generate a true complementary to create a range\n  if (stopColors.length === 1) {\n    stopColors.push(generateComplementary(stopColors[0]!));\n  }\n\n  // Validate format once\n  stopColors.forEach(color => {\n    if (!isColorValid(color)) {\n      throw new Error(`Invalid color format: ${color}`);\n    }\n  });\n\n  // 3. Optimization: Pre-calculate RGB values for all stops\n  // This avoids re-parsing hex strings inside the loop\n  const rgbStops = stopColors.map(parseColorToRgb);\n\n  // 4. Generate Gradient\n  const result: string[] = new Array(numberOfColors);\n  const lastIndex = numberOfColors - 1;\n\n  // We loop exactly 'numberOfColors' times to ensure the array size is correct\n  for (let i = 0; i < numberOfColors; i++) {\n    // If only 1 color requested (or single pixel), return the first color\n    if (lastIndex === 0) {\n      result[i] = stopColors[0]!;\n      continue;\n    }\n\n    // Calculate global percentage (0.0 to 1.0)\n    const t = i / lastIndex;\n\n    // Calculate which segment we are in (between which two stop colors)\n    // (rgbStops.length - 1) is the number of segments\n    const segmentTotal = rgbStops.length - 1;\n    const segmentIndex = Math.floor(t * segmentTotal);\n    \n    // Clamp segment index to avoid overflow at t=1.0\n    const startStopIndex = Math.min(segmentIndex, segmentTotal - 1);\n    const endStopIndex = startStopIndex + 1;\n\n    // Calculate local interpolation ratio (0.0 to 1.0) within this specific segment\n    // Map t from Global Scope to Local Scope\n    const segmentStep = 1 / segmentTotal;\n    const localT = (t - (startStopIndex * segmentStep)) / segmentStep;\n\n    const startRGB = rgbStops[startStopIndex]!;\n    const endRGB = rgbStops[endStopIndex]!;\n\n    // Linear Interpolation (Lerp)\n    const r = startRGB[0] + (endRGB[0] - startRGB[0]) * localT;\n    const g = startRGB[1] + (endRGB[1] - startRGB[1]) * localT;\n    const b = startRGB[2] + (endRGB[2] - startRGB[2]) * localT;\n\n    result[i] = `#${toHex(r)}${toHex(g)}${toHex(b)}`;\n  }\n\n  return result;\n}\n\nexport { generateGradient };"
